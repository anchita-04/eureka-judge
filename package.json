{
  "name": "eureka-platform",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "api:dev": "pnpm --filter @eureka/api start:dev",
    "api:build": "pnpm --filter @eureka/api build",
    "db:generate": "pnpm --filter @eureka/api prisma:generate",
    "db:migrate": "pnpm --filter @eureka/api prisma:migrate",
    "db:seed": "pnpm --filter @eureka/api prisma:seed"
  }
}
